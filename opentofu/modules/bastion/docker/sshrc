#!/bin/sh
URL=$(cat /etc/sec-webhook-url 2>/dev/null)
TOKEN=$(cat /etc/sec-webhook-token 2>/dev/null)
[ -z "$URL" ] && exit 0
if [ -n "$TOKEN" ]; then
  curl -fsS -m 5 -X POST "$URL" \
    -H "Authorization: Bearer ${TOKEN}" \
    -H 'Content-Type: application/json' \
    -d "{\"event\":\"bastion_login\",\"user\":\"$(id -un)\",\"from\":\"$SSH_CLIENT\",\"ts\":\"$(date -Iseconds 2>/dev/null)\"}" \
    >/dev/null 2>&1 || true
else
  curl -fsS -m 5 -X POST "$URL" \
    -H 'Content-Type: application/json' \
    -d "{\"event\":\"bastion_login\",\"user\":\"$(id -un)\",\"from\":\"$SSH_CLIENT\",\"ts\":\"$(date -Iseconds 2>/dev/null)\"}" \
    >/dev/null 2>&1 || true
fi
exit 0
