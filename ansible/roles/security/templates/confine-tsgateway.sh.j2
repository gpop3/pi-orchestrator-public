#!/usr/bin/env bash
# {{ ansible_managed }}
# Confine ts-gateway : il ne peut joindre QUE nginx:{{ security_tsgateway_allowed_port }}.
# Tout autre trafic issu de ts-gateway est jete (anti-pivot lateral).
# Idempotent : verifie l'existence de chaque regle avant de l'ajouter.
set -uo pipefail

TS_IP="{{ security_tsgateway_ip }}"
NGINX_IP="{{ security_nginx_edge_ip }}"
PORT="{{ security_tsgateway_allowed_port }}"
CHAIN="DOCKER-USER"

# Attendre que la chaine DOCKER-USER existe (creee par Docker au demarrage).
for _ in $(seq 1 30); do
  iptables -L "$CHAIN" -n >/dev/null 2>&1 && break
  sleep 2
done

add_rule() {
  # $@ = specification de la regle (sans -A/-I)
  if ! iptables -C "$CHAIN" "$@" 2>/dev/null; then
    iptables -I "$CHAIN" "$@"
  fi
}

# 1) Autoriser le retour des connexions deja etablies (vers ts-gateway)
add_rule -d "$TS_IP" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# 2) Autoriser ts-gateway -> nginx UNIQUEMENT sur le port de la zone tailnet
add_rule -s "$TS_IP" -d "$NGINX_IP" -p tcp --dport "$PORT" -j ACCEPT

# 3) Jeter TOUT le reste venant de ts-gateway (insere en DERNIER => evalue apres
#    les ACCEPT ci-dessus, qui ont ete inseres en tete par -I).
if ! iptables -C "$CHAIN" -s "$TS_IP" -j DROP 2>/dev/null; then
  iptables -A "$CHAIN" -s "$TS_IP" -j DROP
fi

logger -t confine-tsgateway "regles DOCKER-USER appliquees : ts-gateway -> nginx:${PORT} uniquement"
