#!/usr/bin/env bash
# {{ ansible_managed }}
set -uo pipefail

TS_IP="{{ security_tsgateway_ip }}"
NGINX_IP="{{ security_nginx_edge_ip }}"
PORT="{{ security_tsgateway_allowed_port }}"
EDGE_SUBNET="{{ security_edge_subnet }}"
BACKEND_SUBNET="{{ security_backend_subnet }}"

for _ in $(seq 1 30); do
  iptables -L DOCKER-USER -n >/dev/null 2>&1 && break
  sleep 2
done

# --- Nettoyage ---
while iptables -D DOCKER-USER -d "$TS_IP" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null; do :; done
while iptables -D DOCKER-USER -s "$TS_IP" -d "$NGINX_IP" -p tcp --dport "$PORT" -j ACCEPT 2>/dev/null; do :; done
while iptables -D DOCKER-USER -s "$TS_IP" -d "$EDGE_SUBNET" -j DROP 2>/dev/null; do :; done
while iptables -D DOCKER-USER -s "$TS_IP" -d "$BACKEND_SUBNET" -j DROP 2>/dev/null; do :; done

# --- Autoriser le RETOUR des connexions etablies vers ts-gateway ---
iptables -I DOCKER-USER -d "$TS_IP" -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# --- Autoriser ts-gateway -> nginx:PORT (zone tailnet, sa seule voie interne) ---
iptables -I DOCKER-USER -s "$TS_IP" -d "$NGINX_IP" -p tcp --dport "$PORT" -j ACCEPT

# --- Bloquer ts-gateway -> reseaux Docker internes (edge + backend), gateway/hote inclus ---
iptables -A DOCKER-USER -s "$TS_IP" -d "$EDGE_SUBNET" -j DROP
iptables -A DOCKER-USER -s "$TS_IP" -d "$BACKEND_SUBNET" -j DROP
